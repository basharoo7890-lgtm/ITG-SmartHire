<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Employment</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css"/>
    <link rel="stylesheet" href="~/Employment.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/Fontawesome/css/all.min.css" />
</head>

<body>
    <header>
        <!-- navbar -->
        <nav class="navbar navbar-expand-lg custom-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-briefcase brand-icon me-2"></i>
                    <span class="brand-text">ITG Hire</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto nav-center-links">
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        
                        @if (User.IsInRole("Admin") || User.IsInRole("HR") || !User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="OpenPositions">Open Positions</a>
                            </li>
                        }
                        
                        @if (!User.Identity!.IsAuthenticated || User.IsInRole("Applicant"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Applications" asp-action="MyApplications">My Applications</a>
                            </li>
                        }
                        
                        @if (User.IsInRole("HR"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">HR Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Statistics">Statistics</a>
                            </li>
                        }
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">Admin Panel</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Users">Users</a>
                            </li>
                        }
                    </ul>
                    
                    <div class="d-flex align-items-center nav-right-side">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="me-3" style="color:#1A7193; font-weight:600;">
                                <i class="fa-regular fa-user me-1"></i>@User.Identity.Name
                            </span>
                            
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="Index" class="sign-in-link me-3">Admin Panel</a>
                            }
                            
                            @if (User.IsInRole("HR"))
                            {
                                <a asp-controller="Dashboard" asp-action="Index" class="sign-in-link me-3">HR Dashboard</a>
                            }
                            
                            <a asp-controller="Account" asp-action="Logout" class="btn get-started-btn">Logout</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="nav-link">
                                <i class="fa-regular fa-user nav-user-icon"></i>
                            </a>
                            
                            <a asp-controller="Account" asp-action="Login" class="sign-in-link me-4">Sign In</a>
                            
                            <a asp-controller="Account" asp-action="Register" class="btn get-started-btn">Get Started</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-section">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-3">
                    <h5 class="footer-logo">ITG Hire</h5>
                    <p class="footer-text">
                        Building exceptional teams through professional recruitment solutions.
                    </p>
                </div>

                <div class="col-md-3">
                    <h6 class="footer-heading">For Candidates</h6>
                    <ul class="footer-links">
                        <li>
                            <a asp-controller="Home" asp-action="OpenPositions">Browse Jobs</a>
                        </li>
                        <li>
                            <a asp-controller="Applications" asp-action="MyApplications">My Applications</a>
                        </li>
                        <li>
                            <a asp-controller="Account" asp-action="Register">Get Started</a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-3">
                    <h6 class="footer-heading">Company</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="OpenPositions">Careers</a></li>
                        <li><a asp-controller="Home" asp-action="Index">Contact</a></li>
                    </ul>
                </div>

                <div class="col-md-3">
                    <h6 class="footer-heading">Legal</h6>
                    <ul class="footer-links">
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Terms of Service</a></li>
                    </ul>
                </div>
            </div>

            <hr class="footer-line" />
            <p class="footer-copy text-center">© 2026 ITG Hire. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>