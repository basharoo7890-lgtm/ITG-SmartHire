@model List<Employment.Models.SystemSetting>

@{
    ViewData["Title"] = "System Settings";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header rounded-top-4 py-3 px-4" style="background: linear-gradient(90deg, #1A7193, #149DD2);">
                    <h4 class="text-white mb-0"><i class="fa-solid fa-gear me-2"></i>System Settings</h4>
                </div>
                <div class="card-body p-4">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success rounded-3">
                            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
                        </div>
                    }

                    @if (Model.Count == 0)
                    {
                        <div class="alert alert-info">No settings found.</div>
                    }
                    else
                    {
                        <form asp-action="Settings" method="post">
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <div class="mb-4">
                                    <label class="form-label fw-semibold">@Model[i].SettingKey</label>
                                    @if (!string.IsNullOrEmpty(Model[i].Description))
                                    {
                                        <p class="text-muted small mb-1">@Model[i].Description</p>
                                    }
                                    <input type="hidden" name="[@i].SettingKey" value="@Model[i].SettingKey" />
                                    <input type="text" name="[@i].SettingValue" value="@Model[i].SettingValue" class="form-control" />
                                </div>
                            }
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn text-white px-4" style="background-color:#1A7193">
                                    <i class="fa-solid fa-floppy-disk me-1"></i> Save Settings
                                </button>
                            </div>
                        </form>
                    }

                </div>
            </div>

        </div>
    </div>
</div>