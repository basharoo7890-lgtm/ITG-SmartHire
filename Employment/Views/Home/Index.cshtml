@model List<Employment.Models.Job>

@{
    ViewData["Title"] = "Home";
}

<div class="home-page">

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <div class="hero-content">
                <h1 class="hero-title">Build Your Career with ITG Hire</h1>
                <p class="hero-text">
                    Join our team of talented professionals and shape the future together.
                    Discover opportunities that match your skills and aspirations.
                </p>
                <a asp-controller="Home" asp-action="OpenPositions" class="btn hero-btn">
                    Explore Open Positions
                </a>
            </div>
        </div>
    </section>

    <!-- Search Box -->
    <section class="search-section">
        <div class="container">
            <form method="get" asp-controller="Home" asp-action="OpenPositions" class="search-box shadow-sm" id="searchForm">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <input type="text" name="title" class="form-control search-input" placeholder="Job title or keyword" id="searchKeyword">
                    </div>

                    <div class="col-md-4">
                        <input type="text" name="location" class="form-control search-input" placeholder="Location" id="searchLocation">
                    </div>

                    <div class="col-md-4">
                        <button type="button" class="btn search-btn w-100" id="searchBtn">Search Jobs</button>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <!-- Featured Opportunities -->
    <section class="featured-section">
        <div class="container">

            <div class="text-center mb-5">
                <h2 class="section-title">Featured Opportunities</h2>
                <p class="section-subtitle">
                    Explore our current openings and find the perfect role for your next career move
                </p>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="row g-4">
                    @foreach (var job in Model)
                    {
                        <div class="col-md-4">
                            <div class="job-card h-100">
                                <div class="d-flex justify-content-between align-items-start mb-4">
                                    <div class="job-icon-box">
                                        <i class="fa-solid fa-briefcase job-main-icon"></i>
                                    </div>
                                    <span class="job-type-badge">@job.Status</span>
                                </div>

                                <h4 class="job-card-title">@job.Title</h4>
                                <p class="job-card-department">@job.Department</p>
                                <p class="job-card-location">
                                    <i class="fa-solid fa-location-dot me-1"></i>
                                    @job.Location
                                </p>
                                <p class="job-card-location">
                                    <i class="fa-solid fa-user-clock me-1"></i>
                                    @job.MinExperience years experience
                                </p>

                                <a asp-controller="Home"
                                   asp-action="JobDetails"
                                   asp-route-id="@job.JobId"
                                   class="btn job-details-btn w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <div class="text-center mt-4">
                    <a asp-controller="Home" asp-action="OpenPositions" class="btn view-all-btn">
                        View All Positions
                    </a>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-briefcase" style="font-size:48px; color:#D8E4EA"></i>
                    <h4 class="mt-3" style="color:#78A6B7">No open positions at the moment</h4>
                    <p class="text-muted">Check back later for new opportunities</p>
                    <div class="text-center mt-4">
                        <a asp-controller="Home" asp-action="OpenPositions" class="btn view-all-btn">
                            View All Positions
                        </a>
                    </div>
                </div>
            }

        </div>
    </section>

</div>

<script>
    document.getElementById('searchBtn').addEventListener('click', function() {
        const keyword = document.getElementById('searchKeyword').value.trim();
        const location = document.getElementById('searchLocation').value.trim();
        
        let url = '/Home/OpenPositions';
        const params = [];
        if (keyword) params.push('title=' + encodeURIComponent(keyword));
        if (location) params.push('location=' + encodeURIComponent(location));
        if (params.length > 0) url += '?' + params.join('&');
        
        window.location.href = url;
    });

    // Also trigger on Enter key
    document.getElementById('searchKeyword').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            document.getElementById('searchBtn').click();
        }
    });
    
    document.getElementById('searchLocation').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            document.getElementById('searchBtn').click();
        }
    });
</script>