@model List<Employment.Models.Job>
@{
    ViewData["Title"] = "Home";
}
<div class="home-page">
<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
                <h1 class="hero-title">Build Your Career with ITG Hire</h1>
                <p class="hero-text">
                    Join our team of talented professionals and shape the future together.
                    Discover opportunities that match your skills and aspirations.
                </p>
             <a asp-controller="Home" asp-action="OpenPositions" class="btn hero-btn">Explore Open Positions</a>
        </div>
    </div>
</section>

<!-- Search Box-->
<section class="search-section">
    <div class="container">
        <div class="search-box shadow-sm">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                     <input type="text" class="form-control search-input" placeholder="Job title or keyword" >
                </div>
                    <div class="col-md-4">
                        <input type="text" class="form-control search-input" placeholder="Location">
                    </div>
                <div class="col-md-4">
                        <button class="btn search-btn w-100"> Search Jobs</button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured opportunities -->
<section class="featured-section">
    <div class="container">
        <div class="text-center mb-5">
                <h2 class="section-title">Featured Opportunities</h2>
                <p class="section-subtitle">
                    Explore our current openings and find the perfect role for your next career move
                </p>
        </div>
        @if (Model != null && Model.Count > 0)
            {
                <div class="row g-4">
                    @foreach (var job in Model)
                    {
                        <div class="col-md-4">
                      <div class="job-card h-100">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div class="job-icon">💼</div>
        <span class="job-badge">@job.Status</span>
    </div>
    <div>
        <h4 class="job-title">@job.Title</h4>
        <p class="job-department">@job.Department</p>
        <p class="job-location">@job.Location</p>
    </div>
    <a asp-controller="Home" asp-action="JobDetails" asp-route-id="@job.JobId" class="btn details-btn w-100 mt-3">View Details</a>
</div>
                        </div>
                    }
                </div>

                <div class="text-center mt-4">
                    <a asp-controller="Home" asp-action="OpenPositions" class="btn view-all-btn">View All Positions</a>
                </div>
            }
            else
            
              {
    <div class="text-center py-5">
        <i class="fa-solid fa-briefcase" style="font-size:48px; color:#D8E4EA"></i>
        <h4 class="mt-3" style="color:#78A6B7">No open positions at the moment</h4>
        <p class="text-muted">Check back later for new opportunities</p>
    </div>
    <div class="text-center mt-4">
        <a asp-controller="Home" asp-action="OpenPositions" class="btn view-all-btn">
            View All Positions
        </a>
    </div>
}
            
        </div>
</section>

</div>

<script>
document.querySelector('.search-btn').addEventListener('click', function() {
    const keyword = document.querySelectorAll('.search-input')[0].value.trim();
    const location = document.querySelectorAll('.search-input')[1].value.trim();
    
    let url = '/Home/OpenPositions';
    const params = [];
    if (keyword) params.push('keyword=' + encodeURIComponent(keyword));
    if (location) params.push('location=' + encodeURIComponent(location));
    if (params.length > 0) url += '?' + params.join('&');
    
    window.location.href = url;
});

// Also trigger on Enter key
document.querySelectorAll('.search-input').forEach(input => {
    input.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            document.querySelector('.search-btn').click();
        }
    });
});
</script>