@model Employment.ViewModels.JobDetailsViewModel

@{
    ViewData["Title"] = Model?.Job?.Title ?? "Job Details";
}

@if (Model == null || Model.Job == null)
{
    <div class="container py-5 text-center">
        <h3 style="color:#1A7193">Job not found</h3>
        <a href="/Home/OpenPositions" class="btn mt-3" style="background:#1A7193; color:white; border-radius:10px; padding:10px 24px;">Back to Jobs</a>
    </div>
}
else
{
    <div class="job-details-page">
        <div class="container py-5">

            <div class="mb-4">
                <a asp-controller="Home" asp-action="OpenPositions" class="back-jobs-link">
                    <i class="fa-solid fa-arrow-left me-2"></i>
                    Back to Jobs
                </a>
            </div>

            <div class="row g-4 align-items-start">

                <div class="col-lg-8">
                    <div class="details-card top-job-card">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                            <div class="d-flex align-items-start gap-3">
                                <div class="details-job-icon-box">
                                    <i class="fa-solid fa-briefcase"></i>
                                </div>
                                <div>
                                    <h1 class="details-job-title">@Model.Job.Title</h1>
                                    <div class="details-meta">
                                        <span><i class="fa-regular fa-building me-1"></i>@Model.Job.Department</span>
                                        <span><i class="fa-solid fa-location-dot me-1"></i>@Model.Job.Location</span>
                                        <span><i class="fa-regular fa-clock me-1"></i>Posted on @Model.Job.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>
                            </div>
                            <span class="job-type-badge">@Model.Job.Status</span>
                        </div>

                        <div class="details-extra-info mt-4">
                            @if (Model.Job.SalaryMin.HasValue && Model.Job.SalaryMax.HasValue)
                            {
                                <span><i class="fa-solid fa-dollar-sign me-1"></i>@($"{Model.Job.SalaryMin.Value:0} - {Model.Job.SalaryMax.Value:0}")</span>
                            }
                            else
                            {
                                <span><i class="fa-solid fa-dollar-sign me-1"></i>Salary not specified</span>
                            }
                            <span><i class="fa-solid fa-graduation-cap me-1"></i>@Model.Job.RequiredEducation</span>
                            <span><i class="fa-solid fa-clock me-1"></i>@Model.Job.MinExperience+ years experience</span>
                        </div>

                        @if (ViewBag.AlreadyApplied == true)
                        {
                            <button class="btn w-100 mt-4" disabled style="background:#28a745; color:white; border-radius:10px; padding:12px; font-weight:600; cursor:not-allowed;">
                                <i class="fa-solid fa-check-circle me-2"></i> Already Applied
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Applications"
                               asp-action="Apply"
                               asp-route-jobId="@Model.Job.JobId"
                               class="btn apply-position-btn w-100 mt-4">
                                Apply for This Position
                            </a>
                        }
                    </div>

                    <div class="details-card mt-4">
                        <h2 class="details-section-title">Job Description</h2>
                        <p class="details-text" style="white-space: pre-line">@Model.Job.Description</p>
                    </div>

                    <div class="details-card mt-4">
                        <h2 class="details-section-title">Requirements</h2>
                        <p class="details-text">@Model.Job.RequiredEducation</p>
                    </div>

                    @if (Model.JobSkills != null && Model.JobSkills.Any())
                    {
                        <div class="details-card mt-4">
                            <h2 class="details-section-title">Required Skills</h2>
                            <ul class="details-list">
                                @foreach (var skill in Model.JobSkills)
                                {
                                    <li>
                                        <i class="fa-solid fa-check"></i>
                                        @skill.SkillName
                                        @if (skill.MinYearOfExperience > 0)
                                        {
                                            <span class="text-muted" style="font-size:13px"> — @skill.MinYearOfExperience+ years</span>
                                        }
                                        <span class="ms-2" style="background:#EAF6FA; color:#1A7193; border-radius:20px; padding:2px 10px; font-size:12px;">@skill.ImportantLevel</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>

                <div class="col-lg-4">
                    <div class="apply-sticky-card">
                        <h3>@Model.Job.Title</h3>
                        <p>@Model.Job.Department • @Model.Job.Location</p>
                        @if (ViewBag.AlreadyApplied == true)
                        {
                            <button class="btn w-100" disabled style="background:#28a745; color:white; border-radius:10px; padding:10px; font-weight:600;">
                                <i class="fa-solid fa-check-circle me-2"></i> Already Applied
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Applications"
                               asp-action="Apply"
                               asp-route-jobId="@Model.Job.JobId"
                               class="btn apply-now-btn w-100">
                                Apply Now
                            </a>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
}

<style>
    .job-details-page { background-color: #E0EEF0; min-height: 100vh; padding: 36px 0 60px; }
    .back-jobs-link { color: #1A7193; text-decoration: none; font-weight: 500; display: inline-flex; align-items: center; }
    .back-jobs-link:hover { color: #149DD2; }
    .details-card { background: white; border-radius: 16px; padding: 28px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); margin-bottom: 20px; }
    .details-job-icon-box { width: 70px; height: 70px; background: #EAF6FA; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 28px; color: #1A7193; }
    .details-job-title { color: #1A7193; font-size: 28px; font-weight: 700; }
    .details-meta { display: flex; flex-wrap: wrap; gap: 20px; color: #78A6B7; font-size: 14px; }
    .job-type-badge { background: #EAF6FA; color: #1A7193; padding: 6px 16px; border-radius: 20px; font-size: 13px; }
    .details-extra-info { display: flex; flex-wrap: wrap; gap: 20px; padding-top: 16px; border-top: 1px solid #D8E4EA; }
    .apply-position-btn, .apply-now-btn { background: linear-gradient(90deg, #1A7193, #149DD2) !important; color: white !important; border: none; border-radius: 10px; padding: 14px; font-weight: 600; }
    .details-section-title { color: #1A7193; font-size: 20px; font-weight: 700; margin-bottom: 16px; }
    .details-list { list-style: none; padding: 0; }
    .details-list li { padding: 8px 0; display: flex; align-items: center; gap: 10px; }
    .apply-sticky-card { background: white; border-radius: 16px; padding: 24px; position: sticky; top: 20px; text-align: center; }
    .apply-sticky-card h3 { color: #1A7193; font-size: 20px; font-weight: 700; }
</style>