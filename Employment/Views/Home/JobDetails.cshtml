@model Employment.Models.Job

@{
    ViewData["Title"] = "Job Details";
}

<div class="job-details-page">
    <div class="container py-5">

        <div class="mb-4">
            <a asp-controller="Home" asp-action="OpenPositions" class="back-jobs-link">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Back to Jobs
            </a>
        </div>

        <div class="row g-4 align-items-start">

            <!-- Left Side -->
            <div class="col-lg-8">

                <!-- Top Card -->
                <div class="details-card top-job-card">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="details-job-icon-box">
                                <i class="fa-solid fa-briefcase"></i>
                            </div>

                            <div>
                                <h1 class="details-job-title">@Model.Title</h1>

                                <div class="details-meta">
                                    <span>
                                        <i class="fa-regular fa-building me-1"></i>
                                        @Model.Department
                                    </span>

                                    <span>
                                        <i class="fa-solid fa-location-dot me-1"></i>
                                        @Model.Location
                                    </span>

                                    <span>
                                        <i class="fa-regular fa-clock me-1"></i>
                                        Posted on @Model.CreatedAt.ToString("MMM dd, yyyy")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <span class="job-type-badge">@Model.Status</span>
                    </div>

                    <div class="details-extra-info mt-4">
                        <span>
                            <i class="fa-solid fa-dollar-sign me-1"></i>
                            @if (Model.SalaryMin.HasValue && Model.SalaryMax.HasValue)
                            {
                                @($"{Model.SalaryMin.Value:0} - {Model.SalaryMax.Value:0}")
                            }
                            else
                            {
                                @("Salary not specified")
                            }
                        </span>

                        <span>
                            <i class="fa-solid fa-user-clock me-1"></i>
                            @Model.MinExperience years experience
                        </span>
                    </div>

                    <a asp-controller="Applicant"
                       asp-action="Apply"
                       asp-route-jobId="@Model.JobId"
                       class="btn apply-position-btn w-100 mt-4">
                        Apply for This Position
                    </a>
                </div>

                <!-- Description -->
                <div class="details-card mt-4">
                    <h2 class="details-section-title">Job Description</h2>
                    <p class="details-text">
                        @Model.Description
                    </p>
                </div>

                <!-- Requirements -->
                <div class="details-card mt-4">
                    <h2 class="details-section-title">Requirements</h2>
                    <p class="details-text">
                        @Model.RequiredEducation
                    </p>
                </div>

                <!-- Extra Info -->
                <div class="details-card mt-4">
                    <h2 class="details-section-title">Job Information</h2>

                    <ul class="details-list">
                        <li>
                            <i class="fa-solid fa-check"></i>
                            Department: @Model.Department
                        </li>

                        <li>
                            <i class="fa-solid fa-check"></i>
                            Location: @Model.Location
                        </li>

                        <li>
                            <i class="fa-solid fa-check"></i>
                            Minimum Experience: @Model.MinExperience years
                        </li>

                        <li>
                            <i class="fa-solid fa-check"></i>
                            Status: @Model.Status
                        </li>
                    </ul>
                </div>

            </div>

            <!-- Right Side -->
            <div class="col-lg-4 sticky-parent">
                <div class="apply-sticky-card">
                    <h3>Ready to Apply?</h3>
                    <p>
                        Submit your application and join our team of talented professionals.
                    </p>

                    <a asp-controller="Applicant"
                       asp-action="Apply"
                       asp-route-jobId="@Model.JobId"
                       class="btn apply-position-btn w-100 mt-4">
                        Apply Now
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>