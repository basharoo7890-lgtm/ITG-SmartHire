@model List<Employment.Models.Job>

@{
    ViewData["Title"] = "Open Positions";
    var appliedStatus = ViewBag.AppliedJobs as Dictionary<int, bool> ?? new Dictionary<int, bool>();
}

<style>
    .position-item-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease !important;
        cursor: pointer;
    }
    .position-item-card:hover {
        transform: translateY(-8px) !important;
        box-shadow: 0 12px 32px rgba(26, 113, 147, 0.25) !important;
    }
    .position-applied-btn {
        background-color: #28a745 !important;
        color: white !important;
        border: none;
        border-radius: 10px;
        padding: 12px 24px;
        font-weight: 600;
        font-size: 14px;
        cursor: not-allowed;
        opacity: 0.8;
        pointer-events: none;
    }
    .position-applied-btn i {
        margin-right: 8px;
    }
</style>

<div class="open-positions-page">
    <div class="container py-5">

        <div class="positions-header">
            <h1>Open Positions</h1>
            <p>Explore career opportunities at ITG Hire and find your perfect match</p>
        </div>

        <div class="positions-filter-box">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <input type="text" class="form-control positions-filter-input" placeholder="Job title or keyword" id="searchInput">
                </div>

                <div class="col-md-4">
                    <input type="text" class="form-control positions-filter-input" placeholder="Location" id="locationInput">
                </div>

                <div class="col-md-4">
                    <button class="btn search-btn w-100" onclick="filterJobs()">Search Jobs</button>
                </div>
            </div>
            <div class="positions-filter-footer">
                <span>Showing @(Model != null ? Model.Count : 0) position(s)</span>
                <a href="#">More Filters</a>
            </div>
        </div>

        <div class="positions-list" id="jobsList">

            @if (Model != null && Model.Any())
            {
                @foreach (var job in Model)
                {
                    var lowerTitle = !string.IsNullOrEmpty(job.Title) ? job.Title.ToLower() : "";
                    var lowerLocation = !string.IsNullOrEmpty(job.Location) ? job.Location.ToLower() : "";
                    var hasApplied = appliedStatus.ContainsKey(job.JobId) && appliedStatus[job.JobId];

                    <div class="position-item-card" data-title="@lowerTitle" data-location="@lowerLocation">
                        <div class="position-left">
                            <div class="position-icon-box">
                                <i class="fa-solid fa-briefcase"></i>
                            </div>

                            <div>
                                <h3>@job.Title</h3>

                                <div class="position-meta">
                                    <span>
                                        <i class="fa-regular fa-building me-1"></i>
                                        @job.Department
                                    </span>

                                    <span>
                                        <i class="fa-solid fa-location-dot me-1"></i>
                                        @job.Location
                                    </span>

                                    <span>
                                        <i class="fa-regular fa-clock me-1"></i>
                                        Posted on @job.CreatedAt.ToString("MMM dd, yyyy")
                                    </span>
                                </div>

                                <div class="mt-1" style="color:#78A6B7; font-size:14px">
                                    <span>Min Experience: @job.MinExperience years</span>
                                    @if (!string.IsNullOrEmpty(job.RequiredEducation))
                                    {
                                        <span class="ms-3">• Education: @job.RequiredEducation</span>
                                    }
                                    @if (job.SalaryMin.HasValue && job.SalaryMax.HasValue)
                                    {
                                        <span class="ms-3">• Salary: @job.SalaryMin — @job.SalaryMax</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="position-right">
                            <span class="position-badge">@job.Status</span>

                            <div class="position-buttons">
                               <a asp-controller="Home"
   asp-action="JobDetails"
   asp-route-id="@job.JobId"
   class="btn position-details-btn">
    View Details
</a>

                                @if (hasApplied)
                                {
                                    <button class="btn position-applied-btn" disabled>
                                        <i class="fa-solid fa-check-circle"></i> Already Applied
                                    </button>
                                }
                                else
                                {
                                    <a asp-controller="Applications"
                                       asp-action="Apply"
                                       asp-route-jobId="@job.JobId"
                                       asp-route-title="@job.Title"
                                       asp-route-department="@job.Department"
                                       asp-route-location="@job.Location"
                                       asp-route-type="Full-time"
                                       class="btn position-apply-btn">
                                        Apply Now
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-briefcase" style="font-size:48px; color:#D8E4EA"></i>
                    <h4 class="mt-3" style="color:#78A6B7">No open positions at the moment</h4>
                    <p class="text-muted">Check back later for new opportunities</p>
                </div>
            }

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="positions-pagination">
                <a href="#" class="btn page-btn active">1</a>
            </div>
        }

    </div>
</div>

<script>
    function filterJobs() {
        const search = document.getElementById('searchInput').value.toLowerCase().trim();
        const location = document.getElementById('locationInput').value.toLowerCase().trim();
        const cards = document.querySelectorAll('.position-item-card');
        let visible = 0;

        cards.forEach(card => {
            const title = card.dataset.title || '';
            const loc = card.dataset.location || '';
            const matchSearch = !search || title.includes(search);
            const matchLocation = !location || loc.includes(location);
            card.style.display = matchSearch && matchLocation ? 'flex' : 'none';
            if (matchSearch && matchLocation) visible++;
        });

        const countEl = document.querySelector('.positions-filter-footer span');
        if (countEl) countEl.textContent = 'Showing ' + visible + ' position(s)';
    }

    document.getElementById('searchInput').addEventListener('input', filterJobs);
    document.getElementById('locationInput').addEventListener('input', filterJobs);

    const urlParams = new URLSearchParams(window.location.search);
    const titleParam = urlParams.get('title');
    const locationParam = urlParams.get('location');
    
    if (titleParam) {
        document.getElementById('searchInput').value = titleParam.trim();
    }
    if (locationParam) {
        document.getElementById('locationInput').value = locationParam.trim();
    }
    
    if ((titleParam && titleParam.trim() !== "") || (locationParam && locationParam.trim() !== "")) {
        filterJobs();
    }
</script>