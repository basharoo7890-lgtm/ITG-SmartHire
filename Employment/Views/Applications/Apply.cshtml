@{
    ViewData["Title"] = "Apply for Position";
}

<div class="apply-page">
    <div class="container py-5">
        <a asp-controller="Home" asp-action="JobDetails" class="back-link">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Back to Job Details
        </a>

        <div class="apply-header">
            <h1>Apply for Position</h1>
            <p>Complete the form below to submit your application</p>
        </div>

        <div class="apply-job-card">
            <div class="job-icon">
                <i class="fa-solid fa-briefcase"></i>
            </div>
            <div>
                <h3>@ViewBag.JobTitle</h3>
                <div class="job-meta">
                    <span>@ViewBag.Department</span>
                    <span>•</span>
                    <span>@ViewBag.Location</span>
                    <span>•</span>
                    <span>@ViewBag.JobType</span>
                </div>
            </div>
        </div>

        <form class="application-form-card" asp-controller="Applications" asp-action="Apply" method="post" enctype="multipart/form-data">
            
            <input type="hidden" name="jobId" value="@ViewBag.JobId" />

            <h2>Application Information</h2>

            <h4>Personal Information</h4>

            <div class="row g-4">
                <div class="col-md-6">
                    <label>First Name </label>
                    <input type="text" class="form-control apply-input" placeholder="Your First Name" required>
                </div>
                <div class="col-md-6">
                    <label>Last Name </label>
                    <input type="text" class="form-control apply-input" placeholder="Your Last Name " required>
                </div>
                <div class="col-md-6">
                    <label>Email Address </label>
                    <input type="email" class="form-control apply-input" placeholder="Your Email" required>
                </div>
                <div class="col-md-6">
                    <label>Phone Number </label>
                    <input type="text" name="phone" class="form-control apply-input" placeholder="+962 *********" required>
                </div>
                <div class="col-12">
                    <label>Education Level *</label>
                    <select name="education" class="form-control apply-input" required>
                        <option value="Bachelor">Bachelor</option>
                        <option value="Master">Master</option>
                        <option value="PhD">PhD</option>
                        <option value="Diploma">Diploma</option>
                    </select>
                </div>
            </div>
            <hr>
            
            <h4>Professional Information</h4>

            <div class="row g-4">
                <div class="col-12">
                    <label>Years of Experience *</label>
                    <input type="number" name="experience" class="form-control apply-input" required>
                </div>

                <div class="col-md-6">
                    <label>Expected Monthly Salary *</label>
                    <input type="number" name="expectedSalary" class="form-control apply-input" placeholder="6000" required>
                    <small>Enter amount in USD</small>
                </div>
            </div>
            <hr>

            <div class="mb-4">
                <label>Resume/CV *</label>

                <label class="cv-upload-box" for="cvFile">
                    <i class="fa-solid fa-upload"></i>
                    <span id="fileName">Click to upload or drag and drop</span>
                    <small>PDF, DOC, DOCX (Max 5MB)</small>
                    <input type="file" name="cvFile" id="cvFile" hidden accept=".pdf,.doc,.docx">
                </label>
            </div>

            <hr>

            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" id="confirmInfo" required>
                <label class="form-check-label" for="confirmInfo">
                    I confirm that all information provided is accurate
                </label>
            </div>

            <div class="form-actions">
                <a asp-controller="Home" asp-action="JobDetails" class="btn cancel-btn">Cancel</a>
                <button type="submit" class="btn submit-application-btn">Submit Application</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // سكريبت بسيط بس عشان يظهر اسم الملف لما ترفعه
        document.getElementById('cvFile').onchange = function () {
            if(this.files.length > 0) {
                document.getElementById('fileName').textContent = this.files[0].name;
            }
        };
    </script>
}