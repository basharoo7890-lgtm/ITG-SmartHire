@model List<Employment.Models.Application>

@{
    ViewData["Title"] = "My Applications";
}

<style>
    .my-apps-page { background-color: #E0EEF0; min-height: 100vh; padding: 36px 0 60px; }
    .page-header { background: linear-gradient(90deg, #1A7193, #149DD2); border-radius: 18px; padding: 28px 36px; margin-bottom: 28px; color: white; }
    .page-header h2 { font-size: 28px; font-weight: 700; margin-bottom: 4px; }
    .app-card { background: white; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); padding: 24px; margin-bottom: 16px; transition: transform 0.2s; }
    .app-card:hover { transform: translateY(-3px); }
    .app-title { color: #1A7193; font-size: 18px; font-weight: 700; margin-bottom: 6px; }
    .app-meta { color: #78A6B7; font-size: 14px; margin-bottom: 12px; }
    .status-badge { padding: 6px 16px; border-radius: 20px; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px; }
    .status-pending { background-color: #EAF6FA; color: #1A7193; }
    .status-screening { background-color: #fff8e1; color: #f57f17; }
    .status-review { background-color: #e3f2fd; color: #1565c0; }
    .status-rejected { background-color: #fdecea; color: #c62828; }
    .status-autorejected { background-color: #fdecea; color: #c62828; }
    .status-accepted { background-color: #e8f5e9; color: #2e7d32; }
    .info-message { background: #EAF6FA; border-left: 3px solid #1A7193; border-radius: 0 8px 8px 0; padding: 12px 16px; margin-top: 12px; color: #1A7193; font-size: 14px; line-height: 1.6; }
    .gap-report { background: #f8fbfc; border-left: 3px solid #1A7193; border-radius: 0 8px 8px 0; padding: 12px 16px; margin-top: 12px; color: #334e5a; font-size: 14px; line-height: 1.6; }
    .reject-reason { background: #fdecea; border-left: 3px solid #c62828; border-radius: 0 8px 8px 0; padding: 12px 16px; margin-top: 12px; color: #c62828; font-size: 14px; }
    .score-pill { background: #EAF6FA; color: #1A7193; border-radius: 20px; padding: 4px 14px; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; }
</style>

<div class="my-apps-page">
    <div class="container">

        <div class="page-header">
            <h2><i class="fa-solid fa-file-lines me-2"></i>My Applications</h2>
            <p>Track the status of your job applications</p>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5" style="background:white; border-radius:16px;">
                <i class="fa-solid fa-file-circle-xmark" style="font-size:48px; color:#D8E4EA"></i>
                <h4 class="mt-3" style="color:#78A6B7">No applications yet</h4>
                <p class="text-muted">Browse open positions and apply!</p>
                <a href="/Home/OpenPositions" class="btn mt-2" style="background:#1A7193; color:white; border-radius:10px; padding:10px 24px;">Browse Jobs</a>
            </div>
        }
        else
        {
            @foreach (var app in Model)
            {
                <div class="app-card">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div>
                            <div class="app-title">@(app.Job?.Title ?? "Unknown Job")</div>
                            <div class="app-meta">
                                <i class="fa-solid fa-location-dot me-1"></i>@(app.Job?.Location ?? "N/A") &nbsp;•&nbsp;
                                <i class="fa-regular fa-calendar me-1"></i>Applied: @app.SubmittedAt.ToShortDateString() &nbsp;•&nbsp;
                                <i class="fa-solid fa-dollar-sign me-1"></i>Expected: $@app.ExpectedSalary
                            </div>

                            @* Show AI score if available *@
                            @if (app.AIAnalysis != null && app.AIAnalysis.MatchingScore.HasValue)
                            {
                                <span class="score-pill">
                                    <i class="fa-solid fa-chart-line me-1"></i>Match Score: @((int)app.AIAnalysis.MatchingScore.Value)%
                                </span>
                            }
                        </div>
                        <div>
                            @{
                                // Map status to display text (hide "Shortlisted" from applicant)
                                var displayStatus = app.Status switch 
                                {
                                    "Shortlisted" => "Under Review",
                                    "Screening" => "Screening",
                                    "Rejected" => "Not Selected",
                                    "AutoRejected" => "Not Selected",
                                    "Accepted" => "Accepted",
                                    "Review" => "Under Review",
                                    _ => "Application Received"
                                };
                                
                                var statusClass = app.Status switch 
                                {
                                    "Shortlisted" => "status-review",
                                    "Screening" => "status-screening",
                                    "Rejected" => "status-rejected",
                                    "AutoRejected" => "status-autorejected",
                                    "Accepted" => "status-accepted",
                                    "Review" => "status-review",
                                    _ => "status-pending"
                                };
                                
                                var statusIcon = app.Status switch 
                                {
                                    "Shortlisted" => "fa-regular fa-eye",
                                    "Screening" => "fa-solid fa-spinner",
                                    "Rejected" => "fa-solid fa-circle-xmark",
                                    "AutoRejected" => "fa-solid fa-circle-xmark",
                                    "Accepted" => "fa-solid fa-check-circle",
                                    "Review" => "fa-regular fa-eye",
                                    _ => "fa-solid fa-clock"
                                };
                            }
                            <span class="status-badge @statusClass">
                                <i class="@statusIcon"></i>
                                @displayStatus
                            </span>
                        </div>
                    </div>

                    @* Show friendly message for pending/review applications *@
                    @if (app.Status == "Pending" || app.Status == "Screening" || app.Status == "Shortlisted" || app.Status == "Review")
                    {
                        <div class="info-message">
                            <i class="fa-solid fa-clock me-2"></i>
                            <strong>Application Received:</strong> Your application is being reviewed by our HR team. We'll contact you if your qualifications match our requirements.
                        </div>
                    }

                    @* Show gap report if available from AI *@
                    @if (app.AIAnalysis != null && !string.IsNullOrEmpty(app.AIAnalysis.GapReport) && app.Status != "Pending" && app.Status != "Shortlisted")
                    {
                        <div class="gap-report">
                            <strong><i class="fa-solid fa-envelope me-2"></i>Feedback:</strong><br/>
                            @app.AIAnalysis.GapReport
                        </div>
                    }

                    @* Show auto-reject reason *@
                    @if (app.Status == "AutoRejected")
                    {
                        <div class="reject-reason">
                            <i class="fa-solid fa-circle-info me-2"></i>
                            <strong>Application Status:</strong> Not selected for this position.
                            @if (app.ExpectedSalary > (app.Job?.SalaryMax ?? 999999))
                            {
                                <span> Your expected salary exceeds the budget range for this position.</span>
                            }
                            else if (app.YearsOfExperience < (app.Job?.MinExperience ?? 0))
                            {
                                <span> Your years of experience are below the minimum requirement for this position.</span>
                            }
                            else
                            {
                                <span> Your profile did not meet the specific requirements for this position.</span>
                            }
                            <br/><br/>
                            <small>We encourage you to apply for other positions that match your skills and experience.</small>
                        </div>
                    }
                    
                    @* Show regular rejection message *@
                    @if (app.Status == "Rejected")
                    {
                        <div class="reject-reason">
                            <i class="fa-solid fa-circle-info me-2"></i>
                            <strong>Application Status:</strong> After careful review, we have decided to move forward with other candidates whose qualifications more closely match our requirements.
                            <br/><br/>
                            <small>We appreciate your interest and encourage you to apply for future opportunities.</small>
                        </div>
                    }
                </div>
            }
        }

    </div>
</div>