@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Sign In - ITG Hire</title>

        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/lib/Fontawesome/css/all.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        
        .password-wrapper {
            position: relative;
        }

        .password-toggle {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            cursor: pointer;
            font-size: 1.1rem;
            color: #149DD2;
            padding: 0;
        }

            .password-toggle:focus {
                outline: none;
            }

        /* Hide default browser password reveal icon */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear {
            display: none;
        }

        /* NOTE: display:none on ::-webkit-textfield-decoration-container breaks
           the input's focus/typing in some Chromium versions until the field's
           type attribute changes (e.g. via the eye toggle). Use a non-destructive
           hide instead so the field works correctly on first click. */
        input[type="password"]::-webkit-credentials-auto-fill-button {
            visibility: hidden;
            pointer-events: none;
            position: absolute;
            right: 0;
        }
    </style>
    </head>
    <body>
        <div class="signin-page">
            <div class="container-fluid px-0">
                <div class="row g-0 min-vh-100">

                    <div class="col-lg-6 signin-left d-none d-lg-flex flex-column justify-content-between">
                        <div class="signin-brand">
                            <i class="fa-solid fa-briefcase me-2"></i>
                            <span>ITG Hire</span>
                        </div>

                        <div class="signin-left-content">
                            <h1>Welcome Back</h1>
                            <p>
                            Sign in to access your account and continue your career
                            journey with ITG Hire.
                            </p>
                        </div>

                        <div class="signin-copy">
                            © 2026 ITG Hire. All rights reserved.
                        </div>
                    </div>

                    <div class="col-lg-6 signin-right d-flex align-items-center justify-content-center">
                        <div class="signin-card">
                            <h2>Sign In</h2>
                            <p class="signin-subtitle">Enter your credentials to access your account</p>
                            <form asp-action="Login" asp-controller="Account" method="post">
                                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                                <div class="mb-3">
                                    <label class="form-label">Email Address</label>
                                    <input type="email" name="email" class="form-control signin-input" placeholder="you@example.com" >
                                </div>

                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <div class="password-wrapper">
                                    <input type="password"
                                           name="PasswordHash"
                                           id="password"
                                           class="form-control signin-input"
                                           placeholder="Enter your password"
                                           autocomplete="current-password" />

                                    <button type="button" class="password-toggle" onclick="togglePassword('password', 'passwordIcon')">
                                        <i id="passwordIcon" class="fa-solid fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4 signin-links-row">
                                <div>
                                    <input type="checkbox" id="rememberMe" class="form-check-input me-2" >
                                    <label for="rememberMe" class="small-text">Remember Me</label>
                                </div>
                                <a href="#" class="forgot-link">Forgot password?</a>
                            </div>

                            <button type="submit" class="btn signin-btn w-100">Sign In</button>
                            <p class="signin-bottom-text">
                                Don't have an account?
                                <a asp-controller="Account" asp-action="Register">Create Account</a>
                            </p>
                            </form>

                        </div>
                    <a asp-controller="Home" asp-action="Index" class="back-home-link">← Back to Homepage</a>
                    </div>
                </div>
            </div>
        </div>
        <script src ="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
    </body>
</html>