@model Employment.ViewModels.StatisticsViewModel

@{
    ViewData["Title"] = "Statistics";
}

<style>
    .stats-page { background-color: #E0EEF0; min-height: 100vh; padding: 36px 0 60px; }
    .page-header { background: linear-gradient(90deg, #1A7193, #149DD2); border-radius: 18px; padding: 28px 36px; margin-bottom: 28px; color: white; }
    .page-header h2 { font-size: 28px; font-weight: 700; margin-bottom: 4px; }
    .page-header p { font-size: 15px; opacity: 0.85; margin: 0; }
    .stat-card { background: white; border-radius: 16px; padding: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); height: 100%; }
    .stat-icon { width: 54px; height: 54px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 22px; margin-bottom: 16px; background: #EAF6FA; color: #1A7193; }
    .stat-value { font-size: 36px; font-weight: 700; color: #1A7193; line-height: 1; }
    .stat-label { font-size: 14px; color: #78A6B7; margin-top: 6px; }
    .chart-card { background: white; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); overflow: hidden; margin-bottom: 24px; }
    .chart-card-header { background: linear-gradient(90deg, #1A7193, #149DD2); padding: 14px 24px; }
    .chart-card-header h5 { color: white; margin: 0; font-size: 16px; font-weight: 600; }
    .chart-card-body { padding: 24px; }
    .skill-bar-row { margin-bottom: 14px; }
    .skill-bar-label { display: flex; justify-content: space-between; margin-bottom: 5px; }
    .skill-bar-label span:first-child { color: #334e5a; font-size: 14px; font-weight: 500; }
    .skill-bar-label span:last-child { color: #1A7193; font-size: 14px; font-weight: 700; }
    .skill-bar { height: 10px; border-radius: 10px; background: #EAF6FA; }
    .skill-bar-fill { height: 100%; background: linear-gradient(90deg, #1A7193, #149DD2); border-radius: 10px; }
    .section-title { color: #1A7193; font-size: 20px; font-weight: 700; margin-bottom: 18px; display: flex; align-items: center; gap: 10px; }
</style>

<div class="stats-page">
    <div class="container">

        <!-- Header -->
        <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2><i class="fa-solid fa-chart-pie me-2"></i>Statistics</h2>
                <p>Overview of all applications and hiring metrics</p>
            </div>
            <a href="/Dashboard" class="btn" style="background:white; color:#1A7193; border-radius:12px; font-weight:600; padding:12px 24px;">
                <i class="fa-solid fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>

        <!-- Stat Cards -->
        <div class="section-title"><i class="fa-solid fa-list-ol"></i> Key Metrics</div>
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fa-solid fa-users"></i></div>
                    <div class="stat-value">@Model.TotalApplications</div>
                    <div class="stat-label">Total Applications</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon" style="background:#fdecea; color:#c62828"><i class="fa-solid fa-ban"></i></div>
                    <div class="stat-value" style="color:#c62828">@Model.AutoRejectedCount</div>
                    <div class="stat-label">Auto Rejected (@Model.AutoRejectedPercentage%)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon" style="background:#e8f5e9; color:#2e7d32"><i class="fa-solid fa-star"></i></div>
                    <div class="stat-value" style="color:#2e7d32">@Model.AverageMatchingScore%</div>
                    <div class="stat-label">Avg Matching Score</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fa-solid fa-check-circle"></i></div>
                    <div class="stat-value">@Model.AcceptanceRate%</div>
                    <div class="stat-label">Acceptance Rate</div>
                </div>
            </div>
        </div>

        <!-- Status Breakdown -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-card text-center">
                    <div class="stat-value" style="color:#1A7193">@Model.PendingCount</div>
                    <div class="stat-label">Pending</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card text-center">
                    <div class="stat-value" style="color:#2e7d32">@Model.AcceptedCount</div>
                    <div class="stat-label">Shortlisted</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card text-center">
                    <div class="stat-value" style="color:#c62828">@Model.RejectedCount</div>
                    <div class="stat-label">Rejected</div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row g-4 mb-4">

            <!-- Bar Chart -->
            <div class="col-md-7">
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h5><i class="fa-solid fa-chart-bar me-2"></i>Applications Per Job</h5>
                    </div>
                    <div class="chart-card-body">
                        <canvas id="barChart" height="200"></canvas>
                    </div>
                </div>
            </div>

            <!-- Pie Chart -->
            <div class="col-md-5">
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h5><i class="fa-solid fa-chart-pie me-2"></i>Application Status</h5>
                    </div>
                    <div class="chart-card-body">
                        <canvas id="pieChart" height="200"></canvas>
                    </div>
                </div>
            </div>

        </div>

        <!-- Top Skills -->
        <div class="section-title"><i class="fa-solid fa-code"></i> Top 5 Most Requested Skills</div>
        <div class="chart-card">
            <div class="chart-card-body">
                @if (!Model.TopSkillNames.Any())
                {
                    <p class="text-muted text-center py-3">No skills data available yet.</p>
                }
                else
                {
                    var maxCount = Model.TopSkillCounts.Max();
                    for (int i = 0; i < Model.TopSkillNames.Count; i++)
                    {
                        var pct = maxCount > 0 ? (int)((double)Model.TopSkillCounts[i] / maxCount * 100) : 0;
                        <div class="skill-bar-row">
                            <div class="skill-bar-label">
                                <span>@Model.TopSkillNames[i]</span>
                                <span>@Model.TopSkillCounts[i] jobs</span>
                            </div>
                            <div class="skill-bar">
                                <div class="skill-bar-fill" style="width:@pct%"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Bar Chart
    const barCtx = document.getElementById('barChart').getContext('2d');
    new Chart(barCtx, {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.JobTitles)),
            datasets: [{
                label: 'Applications',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApplicationsPerJob)),
                backgroundColor: '#1A7193',
                borderRadius: 8,
                borderSkipped: false
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { stepSize: 1 } },
                x: { grid: { display: false } }
            }
        }
    });

    // Pie Chart
    const pieCtx = document.getElementById('pieChart').getContext('2d');
    new Chart(pieCtx, {
        type: 'doughnut',
        data: {
            labels: ['Pending', 'Shortlisted', 'Rejected', 'Auto Rejected'],
            datasets: [{
                data: [@Model.PendingCount, @Model.AcceptedCount, @Model.RejectedCount, @Model.AutoRejectedCount],
                backgroundColor: ['#1A7193', '#2e7d32', '#c62828', '#e65100'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
</script>