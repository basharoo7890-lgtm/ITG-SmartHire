@model Employment.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "HR Dashboard";
}

<style>
    .dashboard-page { background-color: #E0EEF0; min-height: 100vh; padding: 36px 0 60px; }
    .dashboard-header { background: linear-gradient(90deg, #1A7193, #149DD2); border-radius: 18px; padding: 32px 36px; margin-bottom: 32px; color: white; }
    .dashboard-header h2 { font-size: 32px; font-weight: 700; margin-bottom: 4px; }
    .dashboard-header p { font-size: 16px; opacity: 0.85; margin: 0; }
    .job-selector { background: white; border-radius: 16px; padding: 20px 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); margin-bottom: 24px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .job-selector label { color: #1A7193; font-weight: 600; font-size: 16px; margin: 0; white-space: nowrap; }
    .job-selector select { height: 44px; border-radius: 10px; border: 1px solid #D8E4EA; color: #1A7193; font-size: 15px; padding: 0 14px; box-shadow: none; min-width: 250px; flex: 1; }
    .job-selector select:focus { border-color: #149DD2; box-shadow: none; outline: none; }
    .candidates-card { background: white; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); overflow: hidden; }
    .candidates-header { background: linear-gradient(90deg, #1A7193, #149DD2); padding: 18px 24px; display: flex; justify-content: space-between; align-items: center; }
    .candidates-header h5 { color: white; margin: 0; font-size: 18px; font-weight: 600; }
    .candidates-header span { background: white; color: #1A7193; border-radius: 20px; padding: 4px 14px; font-size: 14px; font-weight: 600; }
    .table th { color: #78A6B7; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #f0f4f6; padding: 14px 20px; }
    .table td { padding: 14px 20px; color: #334e5a; font-size: 15px; border-bottom: 1px solid #f8fbfc; vertical-align: middle; }
    .table tr:last-child td { border-bottom: none; }
    .table tr:hover td { background-color: #f8fbfc; }
    .score-badge { padding: 5px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; }
    .score-high { background-color: #EAF6FA; color: #1A7193; }
    .score-mid { background-color: #fff8e1; color: #f57f17; }
    .score-low { background-color: #fdecea; color: #c62828; }
    .status-badge { padding: 5px 14px; border-radius: 20px; font-size: 13px; font-weight: 500; }
    .status-pending { background-color: #EAF6FA; color: #1A7193; }
    .status-shortlisted { background-color: #e8f5e9; color: #2e7d32; }
    .status-rejected { background-color: #fdecea; color: #c62828; }
    .details-btn { background-color: #EAF6FA; color: #1A7193; border: none; border-radius: 8px; padding: 7px 14px; font-size: 13px; font-weight: 500; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; }
    .details-btn:hover { background-color: #d0ecf5; color: #1A7193; text-decoration: none; }
    .accept-btn { background-color: #1A7193; color: white; border: none; border-radius: 8px; padding: 7px 14px; font-size: 13px; font-weight: 500; cursor: pointer; }
    .accept-btn:hover { background-color: #155d79; }
    .reject-btn { background-color: #fdecea; color: #c62828; border: none; border-radius: 8px; padding: 7px 14px; font-size: 13px; font-weight: 500; cursor: pointer; }
    .reject-btn:hover { background-color: #f5c6c6; }
    .empty-state { text-align: center; padding: 60px 24px; color: #78A6B7; }
    .empty-state i { font-size: 48px; color: #d0e8f0; margin-bottom: 16px; display: block; }
</style>

<div class="dashboard-page">
    <div class="container">

      <!-- Header -->
<!-- Header -->
<div class="dashboard-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h2><i class="fa-solid fa-users me-2"></i>HR Dashboard</h2>
        <p>Review candidates and manage applications</p>
    </div>
    
    <!-- We add 'ms-auto' to push this whole group to the right, 
         and 'flex-nowrap' to ensure they never stack vertically -->
    <div class="d-flex flex-nowrap gap-3 ms-auto">
        <a href="/Dashboard/Statistics" class="btn" style="background:white; color:#1A7193; border-radius:12px; font-weight:600; padding:12px 24px; display: flex; align-items: center; width: auto; flex-grow: 0;">
            <i class="fa-solid fa-chart-pie me-2"></i>Statistics
        </a>
        <a href="/Admin" class="btn" style="background:white; color:#1A7193; border-radius:12px; font-weight:600; padding:12px 24px; display: flex; align-items: center; width: auto; flex-grow: 0;">
            <i class="fa-solid fa-shield-halved me-2"></i>Admin Panel
        </a>
    </div>
</div>

        <!-- Job Selector -->
        <div class="job-selector">
            <label><i class="fa-solid fa-briefcase me-2"></i>Select Job:</label>
            <form method="get" style="flex:1; display:flex; gap:12px; align-items:center;">
                <select name="jobId" onchange="this.form.submit()">
                    @foreach (var job in Model.AllJobs)
                    {
                        if (job.JobId == Model.JobId)
                        {
                            <option value="@job.JobId" selected>@job.Title</option>
                        }
                        else
                        {
                            <option value="@job.JobId">@job.Title</option>
                        }
                    }
                </select>
            </form>
            <span style="color:#78A6B7; font-size:15px;">
                <strong style="color:#1A7193">@Model.Candidates.Count</strong> candidate(s) found
            </span>
        </div>

        <!-- Candidates Table -->
        <div class="candidates-card">
            <div class="candidates-header">
                <h5><i class="fa-solid fa-users me-2"></i>@Model.JobTitle — Candidates</h5>
         <div class="d-flex align-items-center gap-3">
    <span>@Model.Candidates.Count total</span>
    <a href="/Dashboard/Compare?jobId=@Model.JobId"
        style="background:white; color:#1A7193; border-radius:8px; padding:7px 16px; font-size:14px; font-weight:600; text-decoration:none;">
        <i class="fa-solid fa-scale-balanced me-1"></i>Compare
    </a>
</div>
            </div>

            @if (!Model.Candidates.Any())
            {
                <div class="empty-state">
                    <i class="fa-solid fa-user-slash"></i>
                    <h5 style="color:#1A7193">No candidates yet</h5>
                    <p>No one has applied for this position yet.</p>
                </div>
            }
            else
            {
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Candidate</th>
                            <th>Email</th>
                            <th>Match Score</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Candidates)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:36px; height:36px; border-radius:50%; background:#EAF6FA; display:flex; align-items:center; justify-content:center; color:#1A7193; font-weight:700; font-size:14px; flex-shrink:0;">
                                            @c.CandidateName.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-semibold" style="color:#1A7193">@c.CandidateName</span>
                                    </div>
                                </td>
                                <td style="color:#78A6B7">@c.CandidateEmail</td>
                                <td>
                                    @if (c.MatchingScore.HasValue)
                                    {
                                        var score = (int)c.MatchingScore.Value;
                                        var cls = score >= 80 ? "score-high" : score >= 60 ? "score-mid" : "score-low";
                                        <span class="score-badge @cls">@score%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var statusCls = c.Status == "Shortlisted" ? "status-shortlisted" :
                                                        c.Status == "Rejected" ? "status-rejected" : "status-pending";
                                    }
                                    <span class="status-badge @statusCls">@c.Status</span>
                                </td>
                                <td style="color:#78A6B7">@c.SubmittedAt.ToShortDateString()</td>
                                <td>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a href="/Dashboard/CandidateDetails/@c.ApplicationId" class="details-btn">
                                            <i class="fa-solid fa-eye"></i> Details
                                        </a>
                                        <form method="post" action="/Dashboard/Accept/@c.ApplicationId" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="accept-btn">
                                                <i class="fa-solid fa-check me-1"></i>Accept
                                            </button>
                                        </form>
                                        <form method="post" action="/Dashboard/Reject/@c.ApplicationId" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="reject-btn">
                                                <i class="fa-solid fa-xmark me-1"></i>Reject
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

    </div>
</div>